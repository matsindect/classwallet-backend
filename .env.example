# =============================================================
# Class Wallet Backend — Environment Configuration
# =============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================

# ---- Application ----
APP_NAME=ClassWallet
APP_ENV=development          # development | production
DEBUG=true                   # Set false in production

# ---- Database ----
# Local dev (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./class_wallet.db

# Production (PostgreSQL) — uncomment and set a strong password
# DATABASE_URL=postgresql+asyncpg://class_wallet:i9Z3WxbWDzAxvmq+Un9oIMauDugsyXBuAhnQk+tTWpo=@db:5432/class_wallet

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_DB=class_wallet
POSTGRES_USER=class_wallet
POSTGRES_PASSWORD=i9Z3WxbWDzAxvmq+Un9oIMauDugsyXBuAhnQk+tTWpo=

# ---- Authentication ----
JWT_SECRET_KEY=8b7f261984582ab956e48911ad0cf27656746c970d50f165523ba1eccb8c4d52
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://app.fundowallet.com

# Pagination
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20

# ZB Bank Integration
ZB_BANK_ENABLED=true
ZB_BANK_POLL_INTERVAL_SECONDS=300
ZB_BANK_BASE_URL=https://zbnet.zb.co.zw
ZB_BANK_INSTITUTION_ID=COENDINOVIMBAN
ZB_BANK_PASSWORD=C0EJun10r@2026
ZB_BANK_BILLER_ID=your-biller-id
ZB_BANK_TIMEOUT_SECONDS=30

